packages:
  h2py/*.cabal
  h2py-examples/*.cabal

-- The Hackage index is pinned, so that every build of a commit, on every
-- platform, resolves the same versions, and the licence notices committed
-- under h2py-examples/python/third-party-licenses keep matching what the
-- wheels bundle.  Bump it deliberately, then run scripts/wheel-licenses.py
-- --write (see AGENTS.md).
index-state: hackage.haskell.org 2026-09-20T08:21:40Z
tests: True
benchmarks: True
-- pure-borrow's own freeze and CI pin the linear-base 0.7 series; h2py must
-- not be the first to build it against anything else.
constraints: linear-base ==0.7.*
-- The whole tree builds at -O2, as pure-borrow's own project does: its kernels
-- are what the showcase runs, and its Core inspections assume it.
optimization: 2

-- H2Py depends on the world-indexed `BO'` of pure-borrow, which lives on the
-- `konn/impure-pure-borrow-tagged` branch and is not released yet.
-- The tag pins that branch's head so that the build is reproducible.
source-repository-package
  type: git
  location: https://github.com/SoftwareFoundationGroupAtKyotoU/pure-borrow.git
  tag: a816d2a7eaf62b142faad58f291923ac4d98b469

-- The examples package is only buildable against pure-borrow's example flag off;
-- keep its demo executables out of our plan.
package pure-borrow
  flags: -examples
  tests: False
  benchmarks: False

-- Every object and library built on macOS targets macOS 11, the minimum of
-- GHC's own release libraries and the first release for Apple Silicon, so
-- that a wheel built here installs on macOS 11 and later.
-- The options go to GHC's C and C++ compilers, assembler and linker; as ghc-options
-- they are part of every store package's hash, which MACOSX_DEPLOYMENT_TARGET
-- is not, so a store built for another target is never reused.
-- hatch_build.py and build-wheel.sh read the version from here.
if os(osx)
  package *
    ghc-options:
      -optc-mmacosx-version-min=11.0
      -optcxx-mmacosx-version-min=11.0
      -opta-mmacosx-version-min=11.0
      -optl-mmacosx-version-min=11.0
